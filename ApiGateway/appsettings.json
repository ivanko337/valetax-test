{
  "ReverseProxy": {
    "Routes": {
      "partner-graph": {
        "ClusterId": "partner-graph",
        "Match": {
          "Path": "/partner-graph/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/partner-graph" },
          { "RequestHeader": "X-Gateway-Prefix", "Set": "/partner-graph" }
        ]
      },
      "commissions": {
        "ClusterId": "commissions",
        "Match": {
          "Path": "/commissions/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/commissions" },
          { "RequestHeader": "X-Gateway-Prefix", "Set": "/commissions" }
        ]
      },
      "wallet": {
        "ClusterId": "wallet",
        "Match": {
          "Path": "/wallet/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/wallet" },
          { "RequestHeader": "X-Gateway-Prefix", "Set": "/wallet" }
        ]
      }
    },
    "Clusters": {
      "partner-graph": {
        "Destinations": {
          "partner-graph": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "commissions": {
        "Destinations": {
          "commissions": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "wallet": {
        "Destinations": {
          "wallet": {
            "Address": "http://localhost:5105/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
